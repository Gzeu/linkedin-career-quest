        "name": "Vercel",
        "url": "https://linkedin-career-quest.vercel.app",
        "config": {
          "framework": "Other",
          "build_command": null,
          "output_directory": "./",
          "install_command": null
        },
        "status": "ready",
        "setup_commands": [
          "Connect GitHub repository to Vercel",
          "Select 'Other' as framework preset",
          "No build command needed (static files)",
          "Set output directory to './'",
          "Deploy automatically"
        ]
      },
      {
        "name": "Netlify",
        "url": "https://linkedin-career-quest.netlify.app",
        "config": {
          "build_command": "",
          "publish_directory": "./",
          "functions_directory": null
        },
        "status": "ready",
        "setup_commands": [
          "Connect GitHub repository to Netlify",
          "Leave build command empty",
          "Set publish directory to './'",
          "Enable automatic deployments"
        ]
      }
    ]
  },
